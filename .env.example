# --- App ---
PROJECT_NAME="Admin Core API"
API_V1_STR="/api/v1"
ENVIRONMENT=development

# --- Database (Core - almacena tenants y admins) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/admin_core_db

# --- Seguridad ---
# Genera con: openssl rand -hex 32
JWT_SECRET_KEY=change_this_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change_this_fernet_key

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
